{
  "name": "chrome-mcp-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "pack:ext": "node scripts/pack-extension.mjs",
    "build:local": "node scripts/build-local.mjs",
    "typecheck": "tsc -p worker && tsc -p extension && tsc -p local",
    "test": "vitest run",
    "test:e2e": "node scripts/pack-extension.mjs --dev && npm run build:local && playwright test",
    "deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "setup": "node scripts/setup.mjs",
    "check:live": "node scripts/pack-extension.mjs && node scripts/live-check.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1",
    "ws": "^8.22.2"
  }
}
