{
  "name": "chrome-mcp-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "be0a5bc5312047f1a957afa9f3bc9fd6" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "DeviceHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceHub"] }],
  "vars": {
    "PUBLIC_URL": "https://chrome-mcp-agent.chrome-mcp-agent.workers.dev",
    "ALLOWED_EMAILS": "",
    "EXTENSION_IDS": ""
  }
  // Secrets (wrangler secret put): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_SECRET
}
