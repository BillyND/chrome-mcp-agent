{
  "name": "chrome-mcp-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Only files that exist here are served as-is (the extension zip); every other path reaches the Worker.
  "assets": { "directory": "public" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "be0a5bc5312047f1a957afa9f3bc9fd6" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "DeviceHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceHub"] }],
  "vars": {
    "PUBLIC_URL": "https://chrome-mcp-agent.chrome-mcp-agent.workers.dev"
  }
  // Secrets (wrangler secret put): TOKEN_SECRET, optional ACCESS_PASSWORD (group password)
}
